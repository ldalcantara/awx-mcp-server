[Unit]
Description=AWX MCP Server - HTTP/SSE Mode
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=awxmcp
Group=awxmcp
WorkingDirectory=/opt/awx-mcp-server
Environment="PATH=/opt/awx-mcp-server/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
# AWX connection + ADMIN_TOKEN live here (AWX_BASE_URL, AWX_TOKEN or
# AWX_USERNAME/AWX_PASSWORD, AWX_VERIFY_SSL, ADMIN_TOKEN). The leading '-' makes
# the file optional so the unit still starts when config is provided another way.
EnvironmentFile=-/etc/awx-mcp-server/awx-mcp-server.env

# Use the installed console script with the real 'start' subcommand.
ExecStart=/opt/awx-mcp-server/venv/bin/awx-mcp-server start --host 0.0.0.0 --port 8000

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/awx-mcp-server/data

# Restart policy
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=awx-mcp-server

[Install]
WantedBy=multi-user.target
